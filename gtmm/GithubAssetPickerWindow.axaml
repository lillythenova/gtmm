<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:gtmm.Services"
        x:Class="gtmm.GithubAssetPickerWindow"
        Title="Choose asset"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CardBgBrush}">
    <Border Padding="22"
            Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="24">
        <StackPanel Spacing="18">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Path Width="22"
                      Height="22"
                      Stretch="Fill"
                      Data="M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M12,2 C8.7,5.2 7.7,8.5 7.7,12 C7.7,15.5 8.7,18.8 12,22 M12,2 C15.3,5.2 16.3,8.5 16.3,12 C16.3,15.5 15.3,18.8 12,22 M2,12 L22,12 M3.3,7.5 C8,8.7 16,8.7 20.7,7.5 M3.3,16.5 C8,15.3 16,15.3 20.7,16.5"
                      Fill="Transparent"
                      Stroke="{DynamicResource TextSecondary}"
                      StrokeThickness="1.7"/>
                <TextBlock Text="Choose the DLL or ZIP"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Margin="0,3,0,0">
                <Border Height="52"
                        BorderBrush="{DynamicResource PrimaryPurple}"
                        BorderThickness="2"
                        CornerRadius="5"/>
                <Button x:Name="AssetSelectorButton"
                        Margin="8,3"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Click="OnAssetSelectorClick">
                    <Grid ColumnDefinitions="24,*,24">
                        <TextBlock x:Name="SelectedAssetNameText"
                                   Grid.Column="1"
                                   Foreground="{DynamicResource TextPrimary}"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <PathIcon Grid.Column="2"
                                  Data="M7 10l5 5 5-5z"
                                  Width="20"
                                  Height="20"
                                  Foreground="{DynamicResource TextPrimary}"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <TextBlock Text="File format"
                           FontSize="10.5"
                           Foreground="{DynamicResource PrimaryPurple}"
                           Background="{DynamicResource CardBgBrush}"
                           Padding="4,0"
                           Margin="11,-7,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>
            </Grid>

            <Popup x:Name="AssetPopup"
                   Placement="Bottom"
                   IsLightDismissEnabled="True">
                <Border Width="336"
                        MaxHeight="180"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        BoxShadow="0 4 14 0 #33000000">
                    <ScrollViewer MaxHeight="178"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="AssetItemsControl"
                                      Margin="0"
                                      Padding="0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:GithubReleaseAsset">
                                    <Button Classes="asset-option"
                                            Tag="{Binding}"
                                            Click="OnAssetOptionClick"
                                            Margin="0"
                                            Padding="0"
                                            MinHeight="36"
                                            HorizontalContentAlignment="Left"
                                            VerticalContentAlignment="Center"
                                            CornerRadius="0">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   Margin="0"
                                                   TextAlignment="Left"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Popup>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">
                <Button Classes="picker-action"
                        ToolTip.Tip="Cancel"
                        Click="OnCancelClick">
                    <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                              Width="20"
                              Height="20"
                              Foreground="{DynamicResource OnPrimaryContainer}"/>
                </Button>
                <Button Classes="picker-action"
                        ToolTip.Tip="Download selected asset"
                        Click="OnTrackClick">
                    <PathIcon Data="M5 20v-2h14v2H5zm7-3L5.5 10.5 7 9l4 4V3h2v10l4-4 1.5 1.5L12 17z"
                              Width="20"
                              Height="20"
                              Foreground="{DynamicResource OnPrimaryContainer}"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>

    <Window.Styles>
        <Style Selector="Button.picker-action">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryContainer}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.picker-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource SecondaryContainer}"/>
        </Style>
        <Style Selector="Button.asset-option">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.asset-option:pointerover">
            <Setter Property="Background" Value="{DynamicResource SearchBgBrush}"/>
        </Style>
    </Window.Styles>
</Window>
